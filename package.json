{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:engine": "tsx src/engine/testRunner.ts",
    "test:language": "tsx src/engine/language/testSuite.ts",
    "test:candidate-gate": "tsx src/engine/language/runCandidateRecoveryGateSuite.ts",
    "test:candidate-bdesign": "tsx src/engine/language/candidateIdentityBDesignTest.ts",
    "test:composition-runtime": "tsx src/engine/language/runtimeProjectionTest.ts",
    "test:integration-proof": "tsx src/engine/language/runtimeIntegrationProofTest.ts",
    "test:provenance": "tsx src/engine/provenanceReplayTest.ts",
    "test:identity-continuity": "tsx src/engine/index/entityIdentityResolverTest.ts",
    "test:novel-lifecycle": "tsx src/engine/index/novelLifecycleTest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
